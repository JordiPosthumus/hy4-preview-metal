+        for nm in ("model.layers.0.self_attn.q_a_proj.weight",
+                   "model.layers.5.self_attn.indexer.wk.weight",
+                   "model.embed_tokens.weight"):
+            self.assertIsNotNone(HYV4Model.filter_tensors((nm, lambda: None)), nm)
