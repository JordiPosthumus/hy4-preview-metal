+// PTQ variant of the STQ1_0 encoder: same on-disk format, better scale and zero placement.
+//
+// The reference encoder uses d = amax and zeroes the smallest-|x| lane of each group. Both are
+// weak for post-training quantization of weights that were never trained on the {-d,0,+d} grid:
+// amax pins d to the largest outlier in the block, and the zero choice ignores how much each
+// weight actually matters.
+//
+// Here the scale is the weighted least-squares optimum for a fixed ternary selection, and the
+// forced zero is chosen by the incremental error it causes. quant_weights is optional; when it is
+// null the objective falls back to sigma2 + x^2 weighting only.
+//
+// The 3:4 constraint and the stride-16 grouping are untouched - only which lane is zeroed and what
+// d is. Scale and selection are interdependent, so this alternates them (coordinate descent).
+static void quantize_row_stq1_0_impl(const float * GGML_RESTRICT x, block_stq1_0 * GGML_RESTRICT y, int64_t k,
+                                     const float * GGML_RESTRICT quant_weights) {
+    assert(k % QK_K == 0);
+    const int64_t nb = k / QK_K;
+
+    const int n_iter = 3; // gains past 3 rounds measured below 0.05%
+
+    for (int64_t i = 0; i < nb; ++i) {
+        memset(y[i].qs,   0, sizeof(y[i].qs));
+        memset(y[i].sign, 0, sizeof(y[i].sign));
+
+        const float * xb = x + QK_K*i;
+
+        float sumx2 = 0;
+        float amax  = 0;
+        for (int j = 0; j < QK_K; ++j) {
+            sumx2 += xb[j]*xb[j];
+            const float a = fabsf(xb[j]);
+            if (a > amax) amax = a;
+        }
+        if (!(amax > 0)) {
+            y[i].d = GGML_FP32_TO_FP16(0.f);
+            continue;
+        }
+        const float sigma2 = 2*sumx2/QK_K;
+
+        float weight[QK_K];
+        if (quant_weights) {
+            const float * qw = quant_weights + QK_K*i;
+            for (int j = 0; j < QK_K; ++j) weight[j] = qw[j]*sqrtf(sigma2 + xb[j]*xb[j]);
+        } else {
+            for (int j = 0; j < QK_K; ++j) weight[j] = sqrtf(sigma2 + xb[j]*xb[j]);
+        }
+
+        int8_t sel[QK_K];
+        float  d = amax;
+
+        for (int iter = 0; iter < n_iter; ++iter) {
+            for (int g = 0; g < QK_K/4; ++g) {
+                const int chunk = g / 16;
+                const int gloc  = g % 16;
+                const int base  = chunk*64 + gloc;
+
+                // cost of zeroing lane p is weight*x^2; the alternative is +-d, costing
+                // weight*(|x| - d)^2. Pick the lane whose zeroing is cheapest relative to that.
+                int   zero_pos  = 0;
+                float best_cost = FLT_MAX;
+                for (int p = 0; p < 4; ++p) {
+                    const int   j  = base + p*16;
+                    const float ax = fabsf(xb[j]);
+                    const float cost = weight[j]*(xb[j]*xb[j] - (ax - d)*(ax - d));
+                    if (cost < best_cost) { best_cost = cost; zero_pos = p; }
+                }
+
+                for (int p = 0; p < 4; ++p) {
+                    const int j = base + p*16;
+                    sel[j] = p == zero_pos ? 0 : (xb[j] < 0.0f ? -1 : 1);
+                }
+            }
+
+            float sumqx = 0, sumq2 = 0;
+            for (int j = 0; j < QK_K; ++j) {
+                const float q = sel[j];
+                sumqx += weight[j]*q*xb[j];
+                sumq2 += weight[j]*q*q;
+            }
+            if (!(sumq2 > 0)) break;
+            const float dnew = sumqx/sumq2;
+            // a negative optimum would flip every sign; the selection already carries the signs,
+            // so clamp instead of flipping and keep the previous d
+            if (!(dnew > 0)) break;
+            if (fabsf(dnew - d) <= 1e-6f*d) { d = dnew; break; }
+            d = dnew;
+        }
+
+        y[i].d = GGML_FP32_TO_FP16(d);
+
+        for (int g = 0; g < QK_K/4; ++g) {
+            const int chunk = g / 16;
+            const int gloc  = g % 16;
+            const int base  = chunk*64 + gloc;
+
+            uint8_t qpack = 0;
+            for (int p = 0; p < 4; ++p) {
+                const int8_t s = sel[base + p*16];
+                const uint8_t lane = s == 0 ? 0x1 : (s < 0 ? 0x0 : 0x2);
+                qpack |= (uint8_t)(lane << (2*p));
+            }
+
+            const uint8_t code = stq1_0_qpack_to_slot[qpack];
+            const uint8_t sign = stq1_0_qpack_to_sign[qpack];
+            assert(code != 0xFF);
+
+            y[i].qs  [g/2] |= (uint8_t)((code & 0x0F) << (4 * (g & 1)));
+            y[i].sign[g/8] |= (uint8_t)(sign << (g % 8));
+        }
+    }
+}
