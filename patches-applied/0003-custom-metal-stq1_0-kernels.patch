+// STQ1_0: 256 weights per super-block, groups of 4 weights indexed by a 4-bit code plus a
+// 1-bit table select into a 32-entry codebook of 3:4-sparse ternary patterns, one fp16 scale.
+// Weight w in a block belongs to group g = (w/64)*16 + (w%16) at lane p = (w%64)/16.
+template <typename type4x4>
+void dequantize_stq1_0(device const block_stq1_0 * xb, short il, thread type4x4 & reg) {
+    // il in 0..15 selects the 16-weight chunk [il*16, il*16+16)
+    const float d = xb->d;
+    const int p     = il & 3;   // lane within each 4-weight group
+    const int chunk = il >> 2;  // 64-weight chunk index
+
+    float4x4 reg_f;
+    for (short i = 0; i < 4; ++i) {
+        for (short k = 0; k < 4; ++k) {
+            const int j = i*4 + k;                 // weight offset within the chunk
+            const int g = chunk*16 + j;            // group index 0..63
+            const uint8_t qs   = xb->qs[g >> 1];
+            const uint8_t code = (g & 1) ? (qs >> 4) : (qs & 0x0F);
+            const uint8_t sb   = (xb->sign[g >> 3] >> (g & 7)) & 0x01;
+            const uint8_t qpack = stq1_0_codebook[((uint32_t) sb << 4) | code];
+            reg_f[i][k] = d * (float) (((qpack >> (2*p)) & 3) - 1);
+        }
+    }
+
+    reg = (type4x4) reg_f;
+}
+
+template <typename type4>
+void dequantize_stq1_0_t4(device const block_stq1_0 * xb, short il, thread type4 & reg) {
+    // il in 0..63 selects the 4-weight chunk [il*4, il*4+4)
+    const float d = xb->d;
+    const int p     = (il & 15) >> 2;
+    const int chunk = il >> 4;
+    const int base  = (il & 3) * 4;
+
+    float4 reg_f;
+    for (short m = 0; m < 4; ++m) {
+        const int g = chunk*16 + base + m;
+        const uint8_t qs   = xb->qs[g >> 1];
+        const uint8_t code = (g & 1) ? (qs >> 4) : (qs & 0x0F);
+        const uint8_t sb   = (xb->sign[g >> 3] >> (g & 7)) & 0x01;
+        const uint8_t qpack = stq1_0_codebook[((uint32_t) sb << 4) | code];
+        reg_f[m] = d * (float) (((qpack >> (2*p)) & 3) - 1);
+    }
+
+    reg = (type4) reg_f;
+}
