From bb6e8d30610716ca79a72e83196fb481c42b7f00 Mon Sep 17 00:00:00 2001
From: JordiPosthumus <jordiposthumus@users.noreply.github.com>
Date: Sun, 30 Aug 2026 14:38:50 -0300
Subject: [PATCH] STQ1_0 mul_mv: group-aligned mapping, 45 -> 94 GB/s (2.08x)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- thread t16 owns groups 4*t16..4*t16+3; 4 table gathers per 16 weights
  instead of 16; float4 y loads shared across nr0 rows
- tile N_R0=4/N_SG=4 (validated best in standalone sweep)
- ushort qs loads (2-byte aligned; 42B block stride makes uint loads
  misaligned for odd ib — the bug found via standalone bench v4)
- correctness re-validated on all 3 batch paths after port
---
 ggml/src/ggml-metal/ggml-metal-impl.h |  4 +--
 ggml/src/ggml-metal/ggml-metal.metal  | 49 ++++++++++++++-------------
 2 files changed, 28 insertions(+), 25 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-impl.h b/ggml/src/ggml-metal/ggml-metal-impl.h
index da2ec92..df527f2 100644
--- a/ggml/src/ggml-metal/ggml-metal-impl.h
+++ b/ggml/src/ggml-metal/ggml-metal-impl.h
@@ -24,8 +24,8 @@
 #define N_R0_Q1_0 8
 #define N_SG_Q1_0 2
 
-#define N_R0_STQ1_0 8
-#define N_SG_STQ1_0 2
+#define N_R0_STQ1_0 4
+#define N_SG_STQ1_0 4
 
 #define N_R0_Q2_0 8
 #define N_SG_Q2_0 2
diff --git a/ggml/src/ggml-metal/ggml-metal.metal b/ggml/src/ggml-metal/ggml-metal.metal
index 7354377..84f82d6 100644
--- a/ggml/src/ggml-metal/ggml-metal.metal
+++ b/ggml/src/ggml-metal/ggml-metal.metal
@@ -3775,43 +3775,46 @@ void kernel_mul_mv_stq1_0_f32_impl(
         ax[row] = (device const block_stq1_0 *) ((device char *) src0 + offset0);
     }
 
-    float yl[16];
     float sumf[nr0] = {0.f};
 
-    // 32 threads per simdgroup cover 2 blocks per iteration: 16 threads per block,
-    // each thread owns the 16-weight chunk at element offset il within the block.
-    const short ix = (tiisg/16);
-    const short il = (tiisg%16)*16;
-
-    // fixed per thread: lane p and 64-weight chunk of the group mapping
-    const short p     = (il & 63) >> 4;
-    const short chunk = il >> 6;
-
-    device const float * yb = y + ix*QK_K + il;
+    // group-aligned mapping (validated +63% vs element-offset mapping in bench/kernels.metal):
+    // 16 threads per block-slice, thread t16 owns groups 4*t16..4*t16+3 (16 weights):
+    //   chunk = t16>>2, gloc = (t16&3)*4, lane-m weight at chunk*64 + gloc + m*16
+    //   qs bytes 2*t16, 2*t16+1 (2-byte aligned: 42-byte block stride is even); sign byte t16>>1
+    const short ix  = (tiisg/16);
+    const short t16 = (tiisg%16);
+    const int chunk = t16 >> 2;
+    const int gloc  = (t16 & 3) << 2;
+    const int sbsh  = (t16 & 1) << 2;
 
     for (int ib = ix; ib < nb; ib += N_SIMDWIDTH/16) {
-        FOR_UNROLL (short k = 0; k < 16; k++) {
-            yl[k] = yb[k];
-        }
+        // y float4s for this block iteration, shared across all nr0 rows
+        device const float * yb = y + ib*QK_K + chunk*64 + gloc;
+        const float4 yv0 = *(device const float4 *)(yb);
+        const float4 yv1 = *(device const float4 *)(yb + 16);
+        const float4 yv2 = *(device const float4 *)(yb + 32);
+        const float4 yv3 = *(device const float4 *)(yb + 48);
 
         FOR_UNROLL (short row = 0; row < nr0; row++) {
             device const block_stq1_0 * bx = ax[row] + ib;
+            const ushort qp = *(device const ushort *)(bx->qs + 2*t16);
+            const uchar  sb = bx->sign[t16 >> 1] >> sbsh;
             const float d = bx->d;
 
             float sum = 0.f;
-            FOR_UNROLL (short k = 0; k < 16; k++) {
-                const int g = chunk*16 + k;
-                const uint8_t qs   = bx->qs[g >> 1];
-                const uint8_t code = (g & 1) ? (qs >> 4) : (qs & 0x0F);
-                const uint8_t sb   = (bx->sign[g >> 3] >> (g & 7)) & 0x01;
-                const uint8_t qpack = stq1_0_codebook[((uint32_t) sb << 4) | code];
-                sum += (float) (((qpack >> (2*p)) & 3) - 1) * yl[k];
+            FOR_UNROLL (short j = 0; j < 4; j++) {
+                const uint code = (qp >> (8*(j >> 1) + 4*(j & 1))) & 0xF;
+                const uint b    = (sb >> j) & 1;
+                const uint qpack = stq1_0_codebook[(b << 4) | code];
+                const float l0 = (float)((int)(qpack         & 3) - 1);
+                const float l1 = (float)((int)((qpack >> 2) & 3) - 1);
+                const float l2 = (float)((int)((qpack >> 4) & 3) - 1);
+                const float l3 = (float)((int)((qpack >> 6) & 3) - 1);
+                sum += l0*yv0[j] + l1*yv1[j] + l2*yv2[j] + l3*yv3[j];
             }
 
             sumf[row] += d * sum;
         }
-
-        yb += QK_K * (N_SIMDWIDTH/16);
     }
 
     device float * dst_f32 = (device float *) dst + (uint64_t)im*args.ne0*args.ne1 + (uint64_t)r1*args.ne0;
-- 
2.54.0

