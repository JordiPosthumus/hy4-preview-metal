+        inst = object.__new__(HYV4Model)
+        inst.hparams = {"enable_lm_head_fp32": enable_lm_head_fp32}
+        # attrs the DeepseekV2Model base tensor_force_quant reads when we delegate
+        inst._fp8_as_q8 = False
+        inst._fp8_dequantized = set()
