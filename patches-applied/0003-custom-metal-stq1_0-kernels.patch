+            const int chunk = g / 16;
+            const int gloc  = g % 16;
+            for (int p = 0; p < 4; ++p) {
+                const int q = (qpack >> (2*p)) & 0x3;
+                y[chunk*64 + gloc + p*16] = (float) (q - 1) * d;
+            }
+        }
+
+        y += QK_K;
+    }
